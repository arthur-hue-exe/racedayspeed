# ---------------------------------------------------------------------------
# RACE DAY SPEED & GLORY — variáveis de ambiente
# Copie para .env.local e preencha. Apenas as variáveis NEXT_PUBLIC_ são
# expostas ao browser — e são chaves publicáveis, nunca segredos.
# DATABASE_URL, ADMIN_PASSWORD e SUPABASE_SERVICE_ROLE_KEY são somente do servidor.
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL (Supabase → Connect → Transaction pooler)
# Use a URI do pooler (porta 6543) em produção:
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?sslmode=require"

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Usuário administrador inicial (criado/atualizado pelo script de seed)
ADMIN_EMAIL="admin@racedayspeed.com"
ADMIN_PASSWORD="troque-esta-senha"

# Supabase — valores públicos (podem ir para o browser)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Storage (upload das imagens no painel). A chave publicável não
# autoriza upload: use a secret/service role key, somente no servidor.
# Sem estas variáveis, o upload local grava em public/uploads (apenas dev).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
