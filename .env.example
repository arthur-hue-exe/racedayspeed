# ---------------------------------------------------------------------------
# RACE DAY SPEED & GLORY — variáveis de ambiente
# Copie para .env.local e preencha. Nenhuma chave privada deve ir para o browser:
# todas abaixo são usadas somente no servidor (o prefixo NEXT_PUBLIC_ não é usado).
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL (Supabase → Project Settings → Database → Connection string)
# Use a URI do pooler (porta 6543) em produção:
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Usuário administrador inicial (criado/atualizado pelo script de seed)
ADMIN_EMAIL="admin@racedayspeed.com"
ADMIN_PASSWORD="troque-esta-senha"

# Supabase Storage (upload das imagens no painel). Sem estas variáveis,
# o upload local grava em public/uploads (apenas ambiente de desenvolvimento).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
